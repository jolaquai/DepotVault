<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepotVault.App.ViewModels"
             xmlns:v="using:DepotVault.App.Views"
             x:Class="DepotVault.App.App"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <DataTemplate DataType="vm:LibraryViewModel"><v:LibraryView /></DataTemplate>
    <DataTemplate DataType="vm:AppDetailViewModel"><v:AppDetailView /></DataTemplate>
    <DataTemplate DataType="vm:DownloadsViewModel"><v:DownloadsView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:HelpViewModel"><v:HelpView /></DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
  </Application.Styles>
</Application>
