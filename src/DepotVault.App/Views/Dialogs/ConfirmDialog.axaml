<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="using:DepotVault.App.Views"
                xmlns:vm="using:DepotVault.App.ViewModels"
                x:Class="DepotVault.App.Views.Dialogs.ConfirmDialog"
                x:DataType="vm:ConfirmViewModel"
                Title="{Binding Title}" Width="520" SizeToContent="Height" CanResize="False"
                WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding Details}" IsVisible="{Binding HasDetails}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Grid ColumnDefinitions="16,*" Margin="0,2">
            <TextBlock Grid.Column="0" Text="•" />
            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Background="#C42B1C" Foreground="White" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</v:DialogWindow>
