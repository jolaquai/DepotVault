<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="using:DepotVault.App.Views"
                xmlns:vm="using:DepotVault.App.ViewModels"
                x:Class="DepotVault.App.Views.Dialogs.CopyConsentDialog"
                x:DataType="vm:CopyConsentViewModel"
                Title="Copy files?" Width="480" SizeToContent="Height" CanResize="False"
                WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Classes="h2" Text="Some files cannot be linked" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <TextBlock Classes="muted" TextWrapping="Wrap"
               Text="If you do not allow copying, the switch stops and reports which files could not be placed." />
    <CheckBox Content="Remember my choice (change it later in Settings)" IsChecked="{Binding Remember}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Copy files" Command="{Binding CopyCommand}" Classes="accent" />
      <Button Content="Don't copy" Command="{Binding DeclineCommand}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</v:DialogWindow>
