<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepotVault.App.ViewModels"
             x:Class="DepotVault.App.Views.AppDetailView"
             x:DataType="vm:AppDetailViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="0,0,12,12">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="{Binding Name}" />
        <TextBlock Classes="muted"><Run Text="App ID " /><Run Text="{Binding AppId}" /></TextBlock>
        <TextBlock Classes="muted" Text="{Binding InstallText}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding MetadataText}" TextWrapping="Wrap" />
      </StackPanel>
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Content="Refresh depot info" Command="{Binding RefreshMetadataCommand}" />
        <Button Content="Import manifests from SteamDB..." Command="{Binding ImportCommand}" />
        <Button Content="Review changing files..." Command="{Binding ReviewMutableCommand}" />
        <Button Content="Launch in Steam" Command="{Binding LaunchCommand}" />
        <Button Content="Revert to original install" Command="{Binding RevertCommand}" IsVisible="{Binding HasAdopted}" />
      </WrapPanel>
      <Border IsVisible="{Binding HasPendingReview}" Padding="10" CornerRadius="4" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap">
            <Run Text="{Binding PendingReviewCount}" /><Run Text=" file(s) changed in the library since they were linked. Decide whether they should be shared or kept per version." />
          </TextBlock>
          <Button Grid.Column="1" Content="Review..." Command="{Binding ReviewMutableCommand}" Margin="8,0,0,0" />
        </Grid>
      </Border>
      <StackPanel Spacing="4" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
      </StackPanel>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

      <TextBlock Classes="h2" Text="Depots" />
      <Grid ColumnDefinitions="32,80,*,80,170" Margin="0,0,0,2">
        <TextBlock Grid.Column="1" Text="Depot" Classes="muted" FontSize="12" />
        <TextBlock Grid.Column="2" Text="Name" Classes="muted" FontSize="12" />
        <TextBlock Grid.Column="3" Text="Size" Classes="muted" FontSize="12" HorizontalAlignment="Right" Margin="0,0,12,0" />
        <TextBlock Grid.Column="4" Text="Current manifest" Classes="muted" FontSize="12" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Depots}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DepotItemViewModel">
            <Grid ColumnDefinitions="32,80,*,80,170" Margin="0,2">
              <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
              <TextBlock Grid.Column="1" Text="{Binding DepotId}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                <TextBlock Text="{Binding Platform}" Classes="muted" FontSize="12" IsVisible="{Binding Platform, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <TextBlock Grid.Column="3" Text="{Binding Size}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
              <TextBlock Grid.Column="4" Text="{Binding Current}" Classes="muted" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="Download current build of selected depots" Command="{Binding DownloadCurrentCommand}" />

      <TextBlock Classes="h2" Text="Manifest history" />
      <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasHistory}"
                 Text="No manifest history yet. Steam only reports the current manifest; import older ones from SteamDB." />
      <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" IsVisible="{Binding HasHistory}"
                SelectionMode="Extended" AutoGenerateColumns="False" CanUserResizeColumns="True" GridLinesVisibility="Horizontal" MaxHeight="260">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Date" Binding="{Binding Date}" x:DataType="vm:HistoryItemViewModel" IsReadOnly="True" Width="170" />
          <DataGridTextColumn Header="Depot" Binding="{Binding DepotId}" x:DataType="vm:HistoryItemViewModel" IsReadOnly="True" Width="90" />
          <DataGridTextColumn Header="Manifest ID" Binding="{Binding ManifestId}" x:DataType="vm:HistoryItemViewModel" IsReadOnly="True" Width="215" />
          <DataGridTextColumn Header="Label" Binding="{Binding Label}" x:DataType="vm:HistoryItemViewModel" Width="200" />
          <DataGridCheckBoxColumn Header="Downloaded" Binding="{Binding IsDownloaded}" x:DataType="vm:HistoryItemViewModel" IsReadOnly="True" Width="100" />
          <DataGridCheckBoxColumn Header="Purged" Binding="{Binding Unavailable}" x:DataType="vm:HistoryItemViewModel" IsReadOnly="True" Width="80" />
        </DataGrid.Columns>
      </DataGrid>
      <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding HasHistory}">
        <Button Content="Download selected manifest" Command="{Binding DownloadHistoryCommand}" />
        <Button Content="Delete selected from history..." Command="{Binding DeleteHistoryCommand}" />
      </WrapPanel>

      <TextBlock Classes="h2" Text="Versions in the library" />
      <DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                AutoGenerateColumns="False" CanUserResizeColumns="True" GridLinesVisibility="Horizontal" MaxHeight="300">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" x:DataType="vm:VersionItemViewModel" IsReadOnly="True" Width="70" />
          <DataGridTextColumn Header="Label" Binding="{Binding Label}" x:DataType="vm:VersionItemViewModel" Width="180" />
          <DataGridTextColumn Header="Date" Binding="{Binding Date}" x:DataType="vm:VersionItemViewModel" IsReadOnly="True" Width="170" />
          <DataGridTextColumn Header="Manifests" Binding="{Binding Manifests}" x:DataType="vm:VersionItemViewModel" IsReadOnly="True" Width="280" />
          <DataGridTextColumn Header="On disk" Binding="{Binding UniqueSize}" x:DataType="vm:VersionItemViewModel" IsReadOnly="True" Width="90" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" x:DataType="vm:VersionItemViewModel" IsReadOnly="True" Width="160" />
          <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" x:DataType="vm:VersionItemViewModel" Width="160" />
        </DataGrid.Columns>
      </DataGrid>
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Content="Switch Steam install to this version" Command="{Binding SwitchCommand}" Classes="accent" />
        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" />
        <Button Content="Verify" Command="{Binding VerifyCommand}" />
        <Button Content="Delete..." Command="{Binding DeleteCommand}" />
      </WrapPanel>
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Steam's &quot;Verify integrity of game files&quot; and Steam updates put the current build back into a switched install. Switch again afterwards; the stored versions are not affected." />

      <TextBlock Classes="h2" Text="Advanced" />
      <Grid ColumnDefinitions="Auto,12,260">
        <TextBlock Grid.Column="0" Text="How to place files when switching" VerticalAlignment="Center" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding StrategyOptions}" SelectedIndex="{Binding StrategyIndex}" HorizontalAlignment="Stretch" />
      </Grid>
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Some anti-cheat or DRM systems reject linked files. Change this only if the game refuses to start after switching. Copy uses the full size of the game for every switch." />
      <Button Content="Remove game from DepotVault..." Command="{Binding RemoveAppCommand}" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
